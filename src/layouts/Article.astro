---
import Base from './Base.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site';
import { url } from '../lib/url';
import { formatDate, getRelated, sectionLabel, type Post } from '../lib/posts';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const related = await getRelated(post);
const warm = post.collection === 'thoughts';
---

<Base title={post.data.title} description={post.data.description}>
  <div class="progress" aria-hidden="true"></div>
  <div class="container">
    <header class="article-head">
      <a class:list={['tag', { 'tag-warm': warm }]} href={url(`/${post.collection}/`)} style="text-decoration: none">
        {sectionLabel[post.collection]}・{post.data.tag}
      </a>
      <h1>{post.data.title}</h1>
      <span class="meta">{formatDate(post.data.date)}・閱讀 {post.data.readingMinutes} 分鐘</span>
    </header>

    <div class="article-layout">
      <div style="min-width: 0">
        {toc.length > 1 && (
          <details class="toc toc-mobile">
            <summary>這篇會聊到</summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
        <article class="prose">
          <slot />
        </article>
      </div>

      <aside class="aside">
        {toc.length > 1 && (
          <nav class="toc" aria-label="文章目錄">
            <p style="margin: 8px 0; font-weight: 500">這篇會聊到</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="author-card">
          <span class="name">{site.name}</span>
          <p>{site.role}。{site.tagline}，{site.subTagline}。</p>
          <a class="btn btn-accent" href={site.lineUrl} target="_blank" rel="noopener">LINE 聊聊</a>
        </div>
      </aside>
    </div>

    <section class="after-article">
      <div class="author-card">
        <p style="font-size: 17px">讀到這裡，謝謝你。有想法、有疑問，或只是想聊聊，都歡迎直接傳 LINE 給我。</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <a class="btn btn-accent" href={site.lineUrl} target="_blank" rel="noopener">LINE 聊聊</a>
          <button class="btn btn-outline" type="button" data-share>分享給朋友</button>
        </div>
      </div>
      {related.length > 0 && (
        <>
          <h2>接著讀</h2>
          <div class="related-grid">
            {related.map((p) => <PostCard post={p} />)}
          </div>
        </>
      )}
    </section>
  </div>
</Base>

<script>
  // 頂部閱讀進度條
  const bar = document.querySelector<HTMLElement>('.progress');
  const update = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.width = max > 0 ? `${(h.scrollTop / max) * 100}%` : '0';
  };
  document.addEventListener('scroll', update, { passive: true });
  update();

  // 分享按鈕：手機用系統分享，電腦就複製連結
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) {
          await navigator.share(data);
        } else {
          await navigator.clipboard.writeText(location.href);
          btn.textContent = '連結已複製';
        }
      } catch {}
    });
  });
</script>
