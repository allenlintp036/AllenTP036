---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="認識我" description={`${site.name}：${site.role}。${site.tagline}，${site.subTagline}。`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">{site.role}</p>
      <h1 style="margin-top: 8px">嗨，我是 {site.name}</h1>
    </header>

    <div class="article-layout">
      <article class="prose">
        <div class="hero-photo" style="margin-bottom: 32px">[你的照片]</div>

        <h2>我是誰</h2>
        <p>[用兩三句話介紹自己：在哪裡長大、做保險幾年、為什麼走進這一行。]</p>

        <h2>我怎麼看保險</h2>
        <p>[你的保險觀。例如：我在意的不是你買了什麼，而是真的需要的時候，它跟你當初想的一不一樣。]</p>

        <h2>工作以外的我</h2>
        <p>[例如：我習慣從 YouTube 吸收各種知識，也常常想哲學問題，對法律和政治特別有興趣。]</p>

        <h2>我能幫你什麼</h2>
        <ul>
          <li>[例如：幫你看懂手上的保單，告訴你哪裡有保、哪裡沒保]</li>
          <li>[例如：人生階段改變時（買車、結婚、有小孩），一起想該補什麼]</li>
          <li>[例如：任何跟錢有關、不知道該問誰的問題]</li>
        </ul>

        <blockquote>
          <p>{site.tagline}，{site.subTagline}。</p>
        </blockquote>
      </article>

      <aside style="display: grid; gap: 16px">
        <div class="author-card">
          <span class="name">朋友說我是這樣的人</span>
          <p style="font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--ink)">{site.traits.join('・')}</p>
          <a class="btn btn-accent" href={site.lineUrl} target="_blank" rel="noopener">加 LINE 聊聊</a>
          <button class="btn btn-outline" type="button" data-share>把我介紹給朋友</button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const data = { title: document.title, text: '介紹一個朋友給你認識', url: location.href };
      try {
        if (navigator.share) {
          await navigator.share(data);
        } else {
          await navigator.clipboard.writeText(location.href);
          btn.textContent = '連結已複製，貼給朋友吧';
        }
      } catch {}
    });
  });
</script>
