---
import MiniPyramid from '../components/MiniPyramid.astro';
import PhotoStack from '../components/PhotoStack.astro';
import EconLight from '../components/EconLight.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PostListItem from '../components/PostListItem.astro';
import VideoItem from '../components/VideoItem.astro';
import Poll from '../components/Poll.astro';
import AboutBand from '../components/AboutBand.astro';
import { site } from '../site';
import { url } from '../lib/url';
import { getPosts, getUpcoming, getVideos } from '../lib/posts';
import Upcoming from '../components/Upcoming.astro';
import ShopCard from '../components/ShopCard.astro';
import { publishedShops, shopsIntro } from '../data/shops';

const insurance = (await getPosts('insurance')).slice(0, 3);
const thoughts = (await getPosts('thoughts')).slice(0, 3);
const upcomingInsurance = insurance.length ? [] : (await getUpcoming('insurance')).slice(0, 3);
const upcomingThoughts = thoughts.length ? [] : (await getUpcoming('thoughts')).slice(0, 3);
const videos = (await getVideos()).slice(0, 3);
const homeShops = publishedShops().slice(0, 3);
const question = (await getCollection('questions'))
  .filter((q) => !q.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
---

<Base>
  <div class="container">
    <section class="hero">
      <PhotoStack />
      <div class="hero-text">
        <p class="eyebrow">{site.role}</p>
        <h1>無話不談，<br />無思不想</h1>
        <p class="sub">{site.subTagline}</p>
        <p class="intro">{site.intro}</p>
        <div class="hero-actions">
          <a class="btn btn-dark" href={url('/about/')}>先認識我</a>
          {question && <a class="btn btn-outline" href="#question">看今天的思考題</a>}
        </div>
      </div>
    </section>

    {question && (
      <div id="question" style="scroll-margin-top: 100px">
        <Poll q={question} />
      </div>
    )}

    <a class="wealth-teaser" href={url('/wealth/quiz/')}>
      <div style="display: grid; gap: 12px">
        <p class="eyebrow">財富管理・1 分鐘小測驗</p>
        <h2>你在財富金字塔的<span class="keep">哪一層？</span></h2>
        <p>財富管理就像蓋房子，要從最底層開始。回答 6 個問題，看看你的地基穩不穩、下一步該先補什麼。</p>
        <span class="more-link">開始測驗 →</span>
      </div>
      <MiniPyramid active="risk" tone="solid" class="teaser-pyramid" />
    </a>

    <EconLight />

    <section class="section">
      <div class="section-head">
        <div>
          <h2>就事論事談保險</h2>
          <p>不推銷，只講清楚：什麼情況會賠，什麼情況會有落差。</p>
        </div>
        <a class="more-link" href={url('/insurance/')}>看全部 →</a>
      </div>
      {insurance.length > 0 ? (
        <>
          <div class="card-row">
            {insurance.map((post) => <PostCard post={post} />)}
          </div>
          {insurance.length > 1 && <p class="swipe-hint">← 左右滑動看更多</p>}
        </>
      ) : (
        <Upcoming posts={upcomingInsurance} section="insurance" />
      )}
    </section>

    <div class="two-col">
      <section class="section">
        <div class="section-head">
          <h2>時事觀察評論</h2>
          <a class="more-link" href={url('/thoughts/')}>看全部 →</a>
        </div>
        {thoughts.length > 0 ? thoughts.map((post) => <PostListItem post={post} />) : <Upcoming posts={upcomingThoughts} section="thoughts" />}
      </section>

      <section class="section">
        <div class="section-head">
          <h2>最近在看</h2>
          <a class="more-link" href={url('/watching/')}>看全部 →</a>
        </div>
        {videos.length > 0 ? (
          videos.map((v) => <VideoItem video={v} />)
        ) : (
          <p class="empty-note">最近看的好影片整理中，很快放上來。</p>
        )}
      </section>
    </div>

    {homeShops.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>推薦店家</h2>
            <p>{shopsIntro}</p>
          </div>
          <a class="more-link" href={url('/shops/')}>看全部 →</a>
        </div>
        <div class="card-row shop-row">
          {homeShops.map((s) => <ShopCard shop={s} />)}
        </div>
        <p class="swipe-hint">← 左右滑動看更多</p>
      </section>
    )}

    <AboutBand />
  </div>
</Base>
