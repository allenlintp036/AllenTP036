---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import VideoItem from '../components/VideoItem.astro';

const videos = (await getCollection('videos')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="最近在看" description="我最近在 YouTube 看到、覺得值得花時間的影片，附上我的一句話。">
  <div class="container">
    <header class="page-head">
      <h1>最近在看</h1>
      <p>我大部分的新知識都來自 YouTube。這裡放我覺得值得花時間的影片，附上我的一句話。</p>
    </header>
    <div style="max-width: 800px">
      {videos.map((v) => <VideoItem video={v} />)}
    </div>
  </div>
</Base>
