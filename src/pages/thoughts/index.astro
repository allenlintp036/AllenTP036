---
import Base from '../../layouts/Base.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, getUpcoming } from '../../lib/posts';
import Upcoming from '../../components/Upcoming.astro';

const posts = await getPosts('thoughts');
const upcoming = await getUpcoming('thoughts');
---

<Base title="時事觀察評論" description="新聞、熱門話題、身邊發生的事，我看完之後的想法。">
  <div class="container">
    <header class="page-head">
      <h1>時事觀察評論</h1>
      <p>新聞、熱門話題、身邊發生的事，我看完之後的想法。</p>
    </header>
    <div style="max-width: 800px">
      {posts.map((post) => <PostListItem post={post} showDesc />)}
      {posts.length === 0 && <Upcoming posts={upcoming} section="thoughts" />}
    </div>
  </div>
</Base>
