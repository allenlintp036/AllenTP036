---
// 文章還沒寫完時，先放「寫作中」的標題，讓讀者告訴我想先看哪一篇
import type { Post } from '../lib/posts';
import { site } from '../site';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const warm = posts[0]?.collection === 'thoughts';
---

<div class="upcoming">
  <p class="upcoming-label">寫作中</p>
  {posts.length > 0 && (
    <ul>
      {posts.map((p) => (
        <li>
          <span class:list={['tag', { 'tag-warm': warm }]}>{p.data.tag}</span>
          <span class="title">{p.data.title}</span>
        </li>
      ))}
    </ul>
  )}
  <p class="upcoming-cta">
    想先看哪一篇，或有想問的問題？<a href={site.lineUrl} target="_blank" rel="noopener">LINE 跟我說</a>，我就先寫那篇。
  </p>
</div>
