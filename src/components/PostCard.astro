---
import type { Post } from '../lib/posts';
import { postUrl } from '../lib/posts';
import { url } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const warm = post.collection === 'thoughts';
---

<a class="card" href={url(postUrl(post))}>
  <span class:list={['tag', { 'tag-warm': warm }]}>{post.data.tag}</span>
  <span class="title">{post.data.title}</span>
  <span class="meta">閱讀 {post.data.readingMinutes} 分鐘</span>
</a>
